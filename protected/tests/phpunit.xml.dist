<?xml version="1.0" encoding="UTF-8"?>
<!-- PHPUnit 9. Run from the repo root: phpunit -c protected/tests/phpunit.xml.dist -->
<phpunit colors="true" failOnWarning="true">
    <testsuites>
        <testsuite name="unit">
            <directory>unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
